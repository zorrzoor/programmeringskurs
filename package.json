{
  "name": "programmeringskurs",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.22"
  },
  "scripts": {
    "content": "node scripts/build-content.ts",
    "test": "npm run content && node --test --test-reporter=spec \"server/test/*.test.ts\" \"tests/*.test.ts\" && vitest run --config web/vite.config.ts",
    "typecheck": "npm run content && tsc -p server && tsc -p web && tsc -p scripts",
    "build": "npm run content && npm run pyodide && vite build --config web/vite.config.ts",
    "pyodide": "node scripts/copy-pyodide.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "jsdom": "31.0.0",
    "pyodide": "314.0.7",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5"
  }
}
